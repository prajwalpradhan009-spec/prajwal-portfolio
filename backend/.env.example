# Server port
PORT=3000

# MongoDB Atlas connection string (contact form storage)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# GitHub activity dashboard
# GITHUB_USERNAME is the public GitHub handle to read data for.
GITHUB_USERNAME=prajwalpradhan009-spec
# GITHUB_TOKEN is a personal access token used only on the server.
# Create one at https://github.com/settings/tokens
# A classic token with no scopes is enough; add `read:user` for the most data.
# NEVER commit a real token and never expose it to frontend code.
GITHUB_TOKEN=your_github_personal_access_token
# How long a successful GitHub response is reused before refetching (1-60).
GITHUB_CACHE_MINUTES=10
