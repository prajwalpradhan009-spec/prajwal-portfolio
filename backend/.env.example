# Server port
PORT=3000

# MongoDB Atlas connection string (contact form storage)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional. Node's bundled c-ares resolver can report an unusable nameserver on
# some machines, which makes every mongodb+srv lookup fail with ECONNREFUSED.
# Set one or more resolvers (comma separated) if that happens. Leave unset on
# Render, where the default resolver already works.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# GitHub activity dashboard
# GITHUB_USERNAME is the public GitHub handle to read data for.
GITHUB_USERNAME=prajwalpradhan009-spec
# GITHUB_TOKEN is a personal access token used only on the server.
# Create one at https://github.com/settings/tokens
# A classic token with no scopes is enough; add `read:user` for the most data.
# NEVER commit a real token and never expose it to frontend code.
GITHUB_TOKEN=your_github_personal_access_token
# How long a successful GitHub response is reused before refetching (1-60).
GITHUB_CACHE_MINUTES=10

# Prajwal AI (Google Gemini) - read only on the server, never in the browser.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Leave blank to use the pinned default in gemini.js; set a name to override it.
# Use the current model (gemini-3.8-flash); 1.5, 2.0 and 2.5 have been retired.
GEMINI_MODEL=gemini-3.8-flash
# Questions one visitor may ask in a 10 minute window (1-200). Keep this low:
# Gemini's free tier allows only a small number of requests per day in total.
CHAT_RATE_LIMIT=5

# Optional. Comma separated list of origins allowed to call the API. Entries
# may be bare hosts; a missing https:// scheme is added automatically. Leave
# blank to allow any origin, which is convenient in local development.
# ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
