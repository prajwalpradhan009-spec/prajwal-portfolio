# Environment variables - NEVER commit these
# Covers the Gemini key, the GitHub token and the MongoDB connection string.
# These patterns match at any depth, so backend/.env is covered too.
.env
*.env
.env.*

# ...but the placeholder template is safe to track
!.env.example
!.env.*.example

# Node dependencies
node_modules/
npm-debug.log*

# Local contact form submissions (visitor emails stay private)
backend/data/contacts.json


# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
